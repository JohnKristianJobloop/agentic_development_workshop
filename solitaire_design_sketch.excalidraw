    {
      "id": "TbiteUv_wz0R-SA_2DneE",
      "type": "text",
      "x": -1306.6181611220923,
      "y": 2904.3798573820964,
      "width": 570.5333251953125,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff44f",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1i",
      "roundness": null,
      "seed": 1048952626,
      "version": 923,
      "versionNonce": 1862749874,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779784016526,
      "link": null,
      "locked": false,
      "text": "Game Action Player Can Move Card From one tableau\ncolumn to the next:\n\nAs a player\nI want to move one valid card from one tableau column, to\nanother. \nSo that i free up a column, and can reveal the next card\nin line\n\nimplementation: \nThe player should be able to take one or several face up\ncards, from one tableau, and place it on top of another\ncard in a separate tableau given the receiving card is of\nthe next higher value, and is of a different color shade. \nExample: A-H can be placed on 2-C, 4-C can be placed on\n5-D, collection of cards J-H, 10-C, 9-D can be placed on\nQ-S.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rZgiFNvnHRy2Wp2sijykv",
      "originalText": "Game Action Player Can Move Card From one tableau column to the next:\n\nAs a player\nI want to move one valid card from one tableau column, to another. \nSo that i free up a column, and can reveal the next card in line\n\nimplementation: \nThe player should be able to take one or several face up cards, from one tableau, and place it on top of another card in a separate tableau given the receiving card is of the next higher value, and is of a different color shade. \nExample: A-H can be placed on 2-C, 4-C can be placed on 5-D, collection of cards J-H, 10-C, 9-D can be placed on Q-S.",
      "autoResize": true,
      "lineHeight": 1.25
    },
