      "boundElements": null,
      "updated": 1779785249543,
      "link": null,
      "locked": false,
      "text": "Game Action Player Should be able to take top face up\ncard in Waste pile on top of valid tableau column. \nAs a player\nI want to place the top face up card in a waste pile\non top of a valid open face up card in a tableau column. \nTo potentially open up more plays. \n\nImplementation: If the top face up card in the waste pile\nis the next valid card on top of a face up card in any\ntableau. A player should be able to place said card on top\nof the face up card in a tableau. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "RNg1TO5YeS1kF7IGmslyf",
      "originalText": "Game Action Player Should be able to take top face up card in Waste pile on top of valid tableau column. \nAs a player\nI want to place the top face up card in a waste pile\non top of a valid open face up card in a tableau column. \nTo potentially open up more plays. \n\nImplementation: If the top face up card in the waste pile is the next valid card on top of a face up card in any tableau. A player should be able to place said card on top of the face up card in a tableau. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
