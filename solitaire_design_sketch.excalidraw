    },
    {
      "id": "DvDjNYlunzWX846jEdr3v",
      "type": "text",
      "x": -1312.2977706224974,
      "y": 3343.3543268424005,
      "width": 585.4833374023438,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff44f",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1l",
      "roundness": null,
      "seed": 1446021102,
      "version": 637,
      "versionNonce": 1712859118,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779784913302,
      "link": null,
      "locked": false,
      "text": "Game Action Player can move card from foundation to\ntableau\n\nAs a player\nI want to move a card from a foundation, to a valid slot in\nthe tableau\nSo that i might free up more face-down cards by creating\nlarger column. \n\nImplementation:\nPlayer can take a card from a foundation, and place it on a\nvalid face up card in any tableau column. The face up card\nshould be the next higher value, and of the opposite shade.\nExample: 4-H from foundation can be placed on 5-C, 9-S can\nbe placed on 10-D",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "QLrgXMGG7EQOoXw6ONG6j",
      "originalText": "Game Action Player can move card from foundation to tableau\n\nAs a player\nI want to move a card from a foundation, to a valid slot in the tableau\nSo that i might free up more face-down cards by creating larger column. \n\nImplementation:\nPlayer can take a card from a foundation, and place it on a valid face up card in any tableau column. The face up card should be the next higher value, and of the opposite shade. \nExample: 4-H from foundation can be placed on 5-C, 9-S can be placed on 10-D",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "CwjqeQMZH9OUhQ3FYTpBk",
      "type": "rectangle",
      "x": -1309.9615024743077,
      "y": 3727.95538971719,
      "width": 592.4808790261768,
      "height": 310,
      "angle": 0,
