    },
    {
      "id": "K3CMwwA0JUFwiWeMaZnxq",
      "type": "text",
      "x": -1303.271050754188,
      "y": 3732.95538971719,
      "width": 579.0999755859375,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff44f",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1n",
      "roundness": null,
      "seed": 64146930,
      "version": 755,
      "versionNonce": 1725938354,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779785044874,
      "link": null,
      "locked": false,
      "text": "Game Action Player Should be able to draw x amount of\ncards from deck into waste.\nAs a player\nI want to draw a set amount of cards from the deck face\nup into waste.\nSo that I scan the top card of waste to see if it fits any\ntableau column, or in any foundation. \n\nImplementation: The player should be able to enact the\ndraw action on the deck, it should take an amount of\ncards defined in the draw rule and place them face up in\nthe waste pile. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "CwjqeQMZH9OUhQ3FYTpBk",
      "originalText": "Game Action Player Should be able to draw x amount of cards from deck into waste.\nAs a player\nI want to draw a set amount of cards from the deck face up into waste.\nSo that I scan the top card of waste to see if it fits any tableau column, or in any foundation. \n\nImplementation: The player should be able to enact the draw action on the deck, it should take an amount of cards defined in the draw rule and place them face up in the waste pile. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "MYsQhl3dn8TeHpgwoBuwF",
      "type": "rectangle",
      "x": -1309.9615024743077,
      "y": 4041.25209695982,
      "width": 593.3785773277318,
      "height": 349.2046393048222,
      "angle": 0,
      "strokeColor": "#1e1e1e",
