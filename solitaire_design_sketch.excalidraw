    {
      "id": "6p58M661aPF8ouhMUiQ25",
      "type": "text",
      "x": 1492.0085754394531,
      "y": 2000.4582824707031,
      "width": 858.683349609375,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff44f",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b18V",
      "roundness": null,
      "seed": 352049270,
      "version": 1170,
      "versionNonce": 1828560705,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779181549656,
      "link": null,
      "locked": false,
      "text": "User Story - Session Token Login: \nAs An existing user\nI want to log in passively using my session token\nSo that i don't have to go through username and password based login each time i\nopen the app. \n\nAcceptance: If an existing user with a valid session in AsyncStorage opens the app, the\nvalid session should validate the user, and the user should be able to skip the login\npage, and move directly to protected home view. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "_FpC-EoOTO4lLjf1KkeMj",
      "originalText": "User Story - Session Token Login: \nAs An existing user\nI want to log in passively using my session token\nSo that i don't have to go through username and password based login each time i open the app. \n\nAcceptance: If an existing user with a valid session in AsyncStorage opens the app, the valid session should validate the user, and the user should be able to skip the login page, and move directly to protected home view. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "A4KpSRocZSRPQ-hmD9-MB",
      "type": "rectangle",
      "x": 1479.4668579101562,
