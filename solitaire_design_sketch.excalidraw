    {
      "id": "ZgjyiTgNm3RfIZTLG-koU",
      "type": "text",
      "x": -598.2703139829894,
      "y": 2156.5971721869364,
      "width": 696.0833129882812,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff44f",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1W",
      "roundness": null,
      "seed": 259036782,
      "version": 61,
      "versionNonce": 622714162,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779782203493,
      "link": null,
      "locked": false,
      "text": "Drawrules:\n1. Turning three cards at once to the waste, with no limit on passes\nthrough the deck.\n2. Turning three cards at once to the waste, with three passes\nthrough the deck.\n3. Turning one card at a time to the waste, with three passes through\nthe deck.\n4. Turning one card at a time to the waste with only a single pass\nthrough the deck and playing it if possible.\n5. Turning one card at a time to the waste, with no limit on passes\nthrough the deck.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "R_CUYwJCYDjwM2wSPNkbM",
      "originalText": "Drawrules:\n1. Turning three cards at once to the waste, with no limit on passes through the deck.\n2. Turning three cards at once to the waste, with three passes through the deck.\n3. Turning one card at a time to the waste, with three passes through the deck.\n4. Turning one card at a time to the waste with only a single pass through the deck and playing it if possible.\n5. Turning one card at a time to the waste, with no limit on passes through the deck.",
      "autoResize": true,
      "lineHeight": 1.25
    },
