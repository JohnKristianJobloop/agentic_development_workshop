    {
      "id": "BoboW-STIh96ypnBaScpn",
      "type": "text",
      "x": 1496.60009765625,
      "y": 1206.450050354004,
      "width": 808.3833618164062,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff44f",
