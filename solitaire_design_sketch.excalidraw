    },
    {
      "id": "JDbmhtcsmbCOoppP3vRCL",
      "type": "text",
      "x": -1294.0138825116137,
      "y": 4078.354416612231,
      "width": 561.4833374023438,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff44f",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1p",
      "roundness": null,
      "seed": 325579378,
      "version": 455,
      "versionNonce": 1806079666,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779785130576,
      "link": null,
      "locked": false,
      "text": "Game Action Player should be able to take top face up\ncard in Waste pile into valid Foundation slot. \nAs a player\nI want to take the top face up card\nand place it in a valid foundation slot\nSo i can reach a victory condition. \n\nImplementation: If the top face up card in the waste pile\nis a valid next card on top of any foundation. A player\nshould be able to move that card on top of the valid\nfoundation. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "MYsQhl3dn8TeHpgwoBuwF",
      "originalText": "Game Action Player should be able to take top face up card in Waste pile into valid Foundation slot. \nAs a player\nI want to take the top face up card\nand place it in a valid foundation slot\nSo i can reach a victory condition. \n\nImplementation: If the top face up card in the waste pile is a valid next card on top of any foundation. A player should be able to move that card on top of the valid foundation. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
