    {
      "id": "NU4He3ae6NMm3Wk5nvF_R",
      "type": "text",
      "x": 1510.5252380371094,
      "y": 1755.4582824707031,
      "width": 806.6500244140625,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff44f",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b18l",
      "roundness": null,
      "seed": 988441601,
      "version": 1541,
      "versionNonce": 1446662511,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779181491371,
      "link": null,
      "locked": false,
      "text": "User Story - Logout: \nAs An existing user\nI want to log myself out of the app\nSo that my login session is invalidated, and i'm not verified as myself on the app.  \n\nAcceptance: the app should provide the auth object to firebase signOut(), and re\nshould mark the user as successfully logged out. The user should be rerouted to\nlogin/signUp/guest screen. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "A4KpSRocZSRPQ-hmD9-MB",
      "originalText": "User Story - Logout: \nAs An existing user\nI want to log myself out of the app\nSo that my login session is invalidated, and i'm not verified as myself on the app.  \n\nAcceptance: the app should provide the auth object to firebase signOut(), and re should mark the user as successfully logged out. The user should be rerouted to login/signUp/guest screen. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0uw4npwBbt1ieecSRALCQ",
      "type": "rectangle",
      "x": 1469.2001342773438,
      "y": 1459.650032043457,
      "width": 855.3666992187499,
      "height": 253.48327636718744,
      "angle": 0,
      "strokeColor": "#1e1e1e",
